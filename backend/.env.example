APP_NAME=MT5 Trading Control Center
API_PREFIX=/api/v1
# Prefer the Supabase session pooler URI (postgresql://...@aws-0-....pooler.supabase.com:5432/postgres)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
# Desktop Vite + Expo web. Native apps ignore CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Local PC: 127.0.0.1. Cloud VPS behind HTTPS reverse proxy: 0.0.0.0
BIND_HOST=127.0.0.1
BIND_PORT=8000
# true for phone/cloud. Set false only for local desktop without OTP.
REQUIRE_AUTH=true
MT5_TERMINAL_PATH=
NOTIFY_EMAIL=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM=
# Optional: richer AI chat answers (desk context is always used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXECUTION_ENABLED=false
